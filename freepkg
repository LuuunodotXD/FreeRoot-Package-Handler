#!/bin/sh
set -e

# ─── configuração ────────────────────────────────────────────────────────────
CONF_DIR="/etc/freepkg"
CONF_FILE="$CONF_DIR/freepkg.conf"

if [ ! -f "$CONF_FILE" ]; then
    mkdir -p "$CONF_DIR"
    cat > "$CONF_FILE" <<'EOF'
# freepkg configuration file

REPO="https://raw.githubusercontent.com/LuuunodotXD/FreeRoot-Package-Handler/main/packages"
REPO_INDEX="https://raw.githubusercontent.com/LuuunodotXD/FreeRoot-Package-Handler/main/db/amd64.index"
SOURCES="https://raw.githubusercontent.com/LuuunodotXD/FreeRoot-Package-Handler/main/sources"
SOURCES_INDEX="https://raw.githubusercontent.com/LuuunodotXD/FreeRoot-Package-Handler/main/db/sources.index"
EOF
fi

. "$CONF_FILE"

PKG_DB="/var/lib/freepkg/installed"
PKG_CACHE="/var/cache/freepkg"
BUILD_DIR="/var/tmp/freepkg/build"
LOCAL_INDEX="/var/lib/freepkg/amd64.index"
LOCAL_SOURCES_INDEX="/var/lib/freepkg/sources.index"

mkdir -p "$PKG_DB" "$PKG_CACHE" "$BUILD_DIR"

# ─── helpers de versão ───────────────────────────────────────────────────────
# formato do PKG_DB: name=version|build_date
# build_date: yyyy/mm/dd — comparado como inteiro sem barras
# pacotes sem build_date recebem "0"

get_installed_ver() {
    cat "$PKG_DB/$1" 2>/dev/null | cut -d= -f2 | cut -d'|' -f1
}

get_installed_date() {
    d=$(cat "$PKG_DB/$1" 2>/dev/null | cut -d'|' -f2)
    [ -z "$d" ] && echo "0" || echo "$d"
}

# retorna: newer / same / older  ($1 comparado com $2)
compare_dates() {
    a=$(echo "$1" | tr -d '/')
    b=$(echo "$2" | tr -d '/')
    [ -z "$a" ] && a=0
    [ -z "$b" ] && b=0
    if [ "$a" -gt "$b" ]; then echo "newer"
    elif [ "$a" -eq "$b" ]; then echo "same"
    else echo "older"
    fi
}

# ─── install ─────────────────────────────────────────────────────────────────
# amd64.index: name|version|build_date|desc|deps
install_pkg() {
    ask=0
    pkgname=""

    for arg in "$@"; do
        case "$arg" in
            --ask|-a) ask=1 ;;
            "")       continue ;;
            *)        pkgname="$arg" ;;
        esac
    done

    [ -z "$pkgname" ] && {
        echo "Use: freepkg install [-a|--ask] <package>"
        exit 1
    }

    if is_installed "$pkgname"; then
        echo "==> $pkgname is already installed."
        return 0
    fi

    echo "==> Searching info about $pkgname..."
    curl -fsSL "$REPO/$pkgname/PKGINFO" -o "/tmp/pkginfo_$pkgname" || {
        echo "ERROR: package '$pkgname' not found in repository."
        exit 1
    }

    . "/tmp/pkginfo_$pkgname"

    # tamanho
    size=$(curl -sI "$url" | grep -i content-length | awk '{print $2}' | tr -d '\r')
    if [ -n "$size" ] && [ "$size" -gt 0 ] 2>/dev/null; then
        size_str=$(awk "BEGIN {printf \"%.2f MiB\", $size/1048576}")
    else
        size_str="unknown"
    fi

    echo ""
    echo "  Package : $name-$version"
    echo "  Desc    : $desc"
    [ -n "$deps" ] && echo "  Deps    : $deps"
    echo "  Size    : $size_str"
    echo ""

    if [ "$ask" = "1" ]; then
        printf "==> Proceed? [Y/n] "
        read -r answer
        case "$answer" in
            n|N) echo "==> Aborted."; exit 0 ;;
        esac
    fi

    for dep in $deps; do
        is_installed "$dep" || install_pkg "$dep"
    done

    . "/tmp/pkginfo_$pkgname"

    echo "==> Downloading $name-$version...  Do not turn off target!"
    curl -fsSL "$url" -o "$PKG_CACHE/$name-$version.tar.gz"

    echo "==> Verifying checksum..."
    echo "$sha256  $PKG_CACHE/$name-$version.tar.gz" | sha256sum -c - || {
        echo "ERROR: checksum is invalid. Aborting."
        exit 1
    }

    echo "==> Installing $name-$version..."
    tar -xzf "$PKG_CACHE/$name-$version.tar.gz" -C /
    tar -tzf "$PKG_CACHE/$name-$version.tar.gz" > "$PKG_DB/$name.files"

    _bdate=$(grep "^$name|" "$LOCAL_INDEX" 2>/dev/null | cut -d'|' -f3)
    [ -z "$_bdate" ] && _bdate="0"
    echo "$name=$version|$_bdate" > "$PKG_DB/$name"
    echo "==> $name-$version installed sucessfully."
}

# ─── remove ──────────────────────────────────────────────────────────────────
remove_pkg() {
    force=0
    pkgname=""

    for arg in "$@"; do
        case "$arg" in
            --force|-f) force=1 ;;
            "")         continue ;;
            *)          pkgname="$arg" ;;
        esac
    done

    [ -z "$pkgname" ] && {
        echo "Use: freepkg remove [-f|--force] <package>"
        exit 1
    }

    if ! is_installed "$pkgname"; then
        if [ "$force" = "1" ]; then
            echo "==> WARNING: $pkgname not in database, forcing removal..."
        else
            echo "==> $pkgname is not installed. Use --force to remove anyway."
            exit 1
        fi
    fi

    # checa dependências
    if is_installed "$pkgname"; then
        deps_on=""
        for pkg in $(ls "$PKG_DB/" | grep -v "\.files$"); do
            pname=$(cat "$PKG_DB/$pkg" | cut -d= -f1)
            . "/tmp/pkginfo_$pname" 2>/dev/null || \
                curl -fsSL "$REPO/$pname/PKGINFO" -o "/tmp/pkginfo_$pname" 2>/dev/null && \
                . "/tmp/pkginfo_$pname"
            for dep in $deps; do
                [ "$dep" = "$pkgname" ] && deps_on="$deps_on $pname"
            done
        done

        if [ -n "$deps_on" ]; then
            echo "==> ERROR: cannot remove '$pkgname', required by:$deps_on"
            exit 1
        fi
    fi

    echo "==> Removing $pkgname..."
    if [ -f "$PKG_DB/$pkgname.files" ]; then
        while read -r file; do
            case "$file" in */) continue ;; esac
            rm -f "/$file"
        done < "$PKG_DB/$pkgname.files"
        rm -f "$PKG_DB/$pkgname.files"
    else
        echo "==> WARNING: no file manifest found, only removing from database."
    fi

    rm -f "$PKG_DB/$pkgname"
    echo "==> $pkgname removed sucessfully."
}

# ─── update ──────────────────────────────────────────────────────────────────
update_db() {
    echo "==> Syncing package database..."

    curl -fsSL "$REPO_INDEX" -o "$LOCAL_INDEX" || {
        echo "ERROR: could not fetch binary package index."
        exit 1
    }

    curl -fsSL "$SOURCES_INDEX" -o "$LOCAL_SOURCES_INDEX" || {
        echo "ERROR: could not fetch sources index."
        exit 1
    }

    bin_count=$(grep -vc "^#" "$LOCAL_INDEX" 2>/dev/null || echo 0)
    src_count=$(grep -vc "^#" "$LOCAL_SOURCES_INDEX" 2>/dev/null || echo 0)
    echo "==> Database synced. $bin_count binary, $src_count source packages available."
}

# ─── search ──────────────────────────────────────────────────────────────────
# amd64.index:   name|version|build_date|desc|deps
# sources.index: name|version|build_date|desc|deps|makedeps
search_pkg() {
    if [ ! -f "$LOCAL_INDEX" ]; then
        echo "==> Local database not found, running update first..."
        update_db
    fi

    if [ -z "$1" ]; then
        echo "==> Binary packages:"
        grep -v "^#" "$LOCAL_INDEX" | while IFS="|" read -r name version bdate desc deps; do
            echo "  $name ($version) - $desc"
        done
        echo ""
        echo "==> Source packages:"
        grep -v "^#" "$LOCAL_SOURCES_INDEX" | while IFS="|" read -r name version bdate desc deps makedeps; do
            echo "  $name ($version) - $desc"
        done
    else
        bin_result=$(grep -i "^$1|" "$LOCAL_INDEX" 2>/dev/null || true)
        src_result=$(grep -i "^$1|" "$LOCAL_SOURCES_INDEX" 2>/dev/null || true)

        if [ -z "$bin_result" ] && [ -z "$src_result" ]; then
            echo "==> No packages found for '$1'."
            return 0
        fi

        if [ -n "$bin_result" ]; then
            echo "$bin_result" | while IFS="|" read -r name version bdate desc deps; do
                echo "  [binary] $name ($version) - $desc"
                [ -n "$deps" ] && echo "  deps: $deps"
                is_installed "$name" && echo "  [installed]"
            done
        fi

        if [ -n "$src_result" ]; then
            echo "$src_result" | while IFS="|" read -r name version bdate desc deps makedeps; do
                echo "  [source] $name ($version) - $desc"
                [ -n "$deps" ]     && echo "  deps: $deps"
                [ -n "$makedeps" ] && echo "  makedeps: $makedeps"
                is_installed "$name" && echo "  [installed]"
            done
        fi
    fi
}

# ─── upgrade ─────────────────────────────────────────────────────────────────
upgrade_pkg() {
    compile=0
    pkgname=""

    for arg in "$@"; do
        case "$arg" in
            --compile|-c) compile=1 ;;
            "")           continue ;;
            *)            pkgname="$arg" ;;
        esac
    done

    if [ ! -f "$LOCAL_INDEX" ] || [ ! -f "$LOCAL_SOURCES_INDEX" ]; then
        echo "==> Local database not found, running update first..."
        update_db
    fi

    if [ -n "$pkgname" ]; then
        upgrade_one "$pkgname" "$compile"
    else
        ls "$PKG_DB/" | grep -v "\.files$" | while read -r pkg; do
            pname=$(cat "$PKG_DB/$pkg" | cut -d= -f1)
            upgrade_one "$pname" "$compile"
        done
    fi
}

upgrade_one() {
    pkgname="$1"
    compile="$2"

    is_installed "$pkgname" || { echo "==> $pkgname is not installed."; return 1; }

    installed_ver=$(get_installed_ver "$pkgname")
    installed_date=$(get_installed_date "$pkgname")

    # info do repositório binário
    bin_entry=$(grep "^$pkgname|" "$LOCAL_INDEX" 2>/dev/null || true)
    bin_ver=$(echo "$bin_entry"  | cut -d'|' -f2)
    bin_date=$(echo "$bin_entry" | cut -d'|' -f3)
    [ -z "$bin_date" ] && bin_date="0"

    # info do repositório de fontes
    src_entry=$(grep "^$pkgname|" "$LOCAL_SOURCES_INDEX" 2>/dev/null || true)
    src_ver=$(echo "$src_entry"  | cut -d'|' -f2)
    src_date=$(echo "$src_entry" | cut -d'|' -f3)
    [ -z "$src_date" ] && src_date="0"

    if [ "$compile" = "0" ]; then
        # modo binário: prioriza binário
        if [ -n "$bin_entry" ]; then
            cmp=$(compare_dates "$bin_date" "$installed_date")
            if [ "$cmp" = "newer" ]; then
                echo "==> Upgrading $pkgname: $installed_ver -> $bin_ver (binary)..."
                _do_upgrade_binary "$pkgname"
            else
                echo "==> $pkgname: already up to date ($installed_ver)."
                # avisa se fonte tem versão mais nova
                if [ -n "$src_entry" ]; then
                    src_cmp=$(compare_dates "$src_date" "$installed_date")
                    if [ "$src_cmp" = "newer" ]; then
                        echo "    NOTE: $pkgname has a newer version in sources ($src_ver). Use 'upgrade -c' to compile it."
                    fi
                fi
            fi
        elif [ -n "$src_entry" ]; then
            # não existe em binário, tenta fonte
            cmp=$(compare_dates "$src_date" "$installed_date")
            if [ "$cmp" = "newer" ]; then
                echo "==> $pkgname not in binary repo, upgrading from source: $installed_ver -> $src_ver..."
                _do_upgrade_source "$pkgname"
            else
                echo "==> $pkgname: already up to date ($installed_ver)."
            fi
        else
            echo "==> $pkgname: not found in any repository, skipping."
        fi
    else
        # modo fonte (-c): prioriza fonte
        if [ -n "$src_entry" ]; then
            cmp=$(compare_dates "$src_date" "$installed_date")
            if [ "$cmp" = "newer" ]; then
                echo "==> Upgrading $pkgname: $installed_ver -> $src_ver (source)..."
                _do_upgrade_source "$pkgname"
            else
                echo "==> $pkgname: already up to date ($installed_ver)."
                # avisa se binário tem versão mais nova
                if [ -n "$bin_entry" ]; then
                    bin_cmp=$(compare_dates "$bin_date" "$installed_date")
                    if [ "$bin_cmp" = "newer" ]; then
                        echo "    NOTE: $pkgname has a newer version in binary repo ($bin_ver). Use 'upgrade' to install it."
                    fi
                fi
            fi
        elif [ -n "$bin_entry" ]; then
            # não existe em fonte, tenta binário
            cmp=$(compare_dates "$bin_date" "$installed_date")
            if [ "$cmp" = "newer" ]; then
                echo "==> $pkgname not in source repo, upgrading from binary: $installed_ver -> $bin_ver..."
                _do_upgrade_binary "$pkgname"
            else
                echo "==> $pkgname: already up to date ($installed_ver)."
            fi
        else
            echo "==> $pkgname: not found in any repository, skipping."
        fi
    fi
}

_do_upgrade_binary() {
    pkgname="$1"
    if [ -f "$PKG_DB/$pkgname.files" ]; then
        while read -r file; do
            case "$file" in */) continue ;; esac
            rm -f "/$file"
        done < "$PKG_DB/$pkgname.files"
        rm -f "$PKG_DB/$pkgname.files"
    fi
    rm -f "$PKG_DB/$pkgname"
    rm -f "$PKG_CACHE/$pkgname-"*.tar.gz
    install_pkg "$pkgname"
}

_do_upgrade_source() {
    pkgname="$1"
    if [ -f "$PKG_DB/$pkgname.files" ]; then
        while read -r file; do
            case "$file" in */) continue ;; esac
            rm -f "/$file"
        done < "$PKG_DB/$pkgname.files"
        rm -f "$PKG_DB/$pkgname.files"
    fi
    rm -f "$PKG_DB/$pkgname"
    rm -f "$PKG_CACHE/$pkgname-"*.tar.gz
    emerge_pkg "$pkgname"
}

# ─── emerge ──────────────────────────────────────────────────────────────────
emerge_pkg() {
    ask=0
    bind=0
    pkgname=""

    for arg in "$@"; do
        case "$arg" in
            --ask)  ask=1 ;;
            --bind) bind=1 ;;
            -ab)    ask=1; bind=1 ;;
            -a)     ask=1 ;;
            -b)     bind=1 ;;
            "")     continue ;;
            *)      pkgname="$arg" ;;
        esac
    done

    [ -z "$pkgname" ] && {
        echo "Use: freepkg emerge [-a|--ask] [-b|--bind] <package>"
        exit 1
    }

    echo "==> Fetching source info for $pkgname..."
    curl -fsSL "$SOURCES/$pkgname/SRCINFO" -o "/tmp/srcinfo_$pkgname" || {
        echo "ERROR: source package '$pkgname' not found."
        exit 1
    }

    . "/tmp/srcinfo_$pkgname"

    # tamanho do fonte
    size=$(curl -sI "$url" | grep -i content-length | awk '{print $2}' | tr -d '\r')
    if [ -n "$size" ] && [ "$size" -gt 0 ] 2>/dev/null; then
        size_str=$(awk "BEGIN {printf \"%.2f MiB\", $size/1048576}")
    else
        size_str="unknown"
    fi

    echo ""
    echo "  Package  : $name-$version"
    echo "  Desc     : $desc"
    [ -n "$deps" ]     && echo "  Deps     : $deps"
    [ -n "$makedeps" ] && echo "  MakeDeps : $makedeps"
    echo "  Size     : $size_str"
    echo ""

    if [ "$ask" = "1" ]; then
        printf "==> Proceed? [Y/n] "
        read -r answer
        case "$answer" in
            n|N) echo "==> Aborted."; exit 0 ;;
        esac
    fi

    # checa makedeps
    for dep in $makedeps; do
        command -v "$dep" >/dev/null 2>&1 || {
            echo "ERROR: build dependency '$dep' not found. Install it first."
            exit 1
        }
    done

    # instala deps de runtime
    for dep in $deps; do
        if ! is_installed "$dep"; then
            if [ "$bind" = "1" ]; then
                # --bind: tenta binário primeiro
                if curl -fsSL "$REPO/$dep/PKGINFO" -o "/tmp/pkginfo_$dep" 2>/dev/null; then
                    install_pkg "$dep"
                else
                    emerge_pkg "$dep"
                fi
            else
                # padrão: tenta fonte primeiro
                if curl -fsSL "$SOURCES/$dep/SRCINFO" -o "/tmp/srcinfo_$dep" 2>/dev/null; then
                    emerge_pkg "$dep"
                else
                    install_pkg "$dep"
                fi
            fi
        fi
    done

    . "/tmp/srcinfo_$pkgname"

    echo "==> Downloading source $name-$version..."
    curl -fsSL "$url" -o "$BUILD_DIR/$name-$version.tar.$compress"

    echo "==> Verifying checksum..."
    echo "$sha256  $BUILD_DIR/$name-$version.tar.$compress" | sha256sum -c - || {
        echo "ERROR: checksum invalid. Aborting."
        exit 1
    }

    echo "==> Extracting..."
    mkdir -p "$BUILD_DIR/$name-$version-src"
    tar -xf "$BUILD_DIR/$name-$version.tar.$compress" \
        -C "$BUILD_DIR/$name-$version-src" --strip-components=1

    pkgdir="$BUILD_DIR/$name-$version-pkg"
    mkdir -p "$pkgdir"

    cd "$BUILD_DIR/$name-$version-src"
    echo "==> Building $name-$version..."

    i=1
    while true; do
        step=$(printf "build_%02d" $i)
        cmd=$(eval echo \$$step)
        [ -z "$cmd" ] && break
        cmd=$(echo "$cmd" | sed "s|__PKGDIR__|$pkgdir|g")
        echo "  => $cmd"
        eval "$cmd" || { echo "ERROR: build failed at step $i."; exit 1; }
        i=$((i + 1))
    done

    echo "==> Installing $name-$version..."
    tar -czf "$BUILD_DIR/$name-$version-built.tar.gz" -C "$pkgdir" .
    tar -xzf "$BUILD_DIR/$name-$version-built.tar.gz" -C /
    tar -tzf "$BUILD_DIR/$name-$version-built.tar.gz" > "$PKG_DB/$name.files"

    _bdate=$(grep "^$name|" "$LOCAL_SOURCES_INDEX" 2>/dev/null | cut -d'|' -f3)
    [ -z "$_bdate" ] && _bdate="0"
    echo "$name=$version|$_bdate" > "$PKG_DB/$name"
    echo "==> $name-$version built and installed sucessfully."
}

# ─── helpers ─────────────────────────────────────────────────────────────────
is_installed() {
    [ -f "$PKG_DB/$1" ]
}

list_installed() {
    echo "==> Installed packages:"
    ls "$PKG_DB/" 2>/dev/null | while read -r pkg; do
        case "$pkg" in *.files) continue ;; esac
        entry=$(cat "$PKG_DB/$pkg")
        name=$(echo "$entry"  | cut -d= -f1)
        ver=$(echo "$entry"   | cut -d= -f2 | cut -d'|' -f1)
        bdate=$(echo "$entry" | cut -d'|' -f2)
        [ "$bdate" = "0" ] || [ -z "$bdate" ] \
            && echo "  $name=$ver" \
            || echo "  $name=$ver ($bdate)"
    done
}

# ─── main ────────────────────────────────────────────────────────────────────
case "$1" in
    install) install_pkg "$2" "$3" ;;
    remove)  remove_pkg  "$2" "$3" ;;
    list)    list_installed ;;
    search)  search_pkg  "$2" ;;
    update)  update_db ;;
    upgrade) upgrade_pkg "$2" "$3" ;;
    emerge)  emerge_pkg  "$2" "$3" "$4" ;;
    *)
        echo "freepkg - package manager"
        echo ""
        echo "Usage: freepkg <command> [options] <package>"
        echo ""
        echo "Commands:"
        echo "  install [-a|--ask] <pkg>             install a binary package"
        echo "  remove  [-f|--force] <pkg>           remove an installed package"
        echo "  list                                  list installed packages"
        echo "  search  [pkg]                         search available packages"
        echo "  update                                sync local package database"
        echo "  upgrade [-c|--compile] [pkg]          upgrade packages"
        echo "  emerge  [-a|--ask] [-b|--bind] <pkg>  build and install from source"
        echo ""
        echo "Config: $CONF_FILE"
        ;;
esac
